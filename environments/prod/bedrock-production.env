# Verified with live Bedrock smoke calls on 2026-09-30. AWS_PROFILE is local only;
# deployed workloads use their IAM role and the default SDK credential chain.
AWS_REGION=us-east-2
BEDROCK_EMBED_REGION=us-east-2
BEDROCK_EMBED_MODEL=us.cohere.embed-v4:0
BEDROCK_EMBED_DIMENSIONS=1024
BEDROCK_RERANK_REGION=us-west-2
BEDROCK_RERANK_MODEL=cohere.rerank-v3-5:0
BEDROCK_GENERATION_MODEL=qwen.qwen3-next-80b-a3b
BEDROCK_VALIDATION_MODEL=qwen.qwen3-next-80b-a3b
RAG_PIPELINE=verified-bedrock
CHAT_BACKEND=bedrock
EMBED_BACKEND=bedrock
VECTOR_BACKEND=pgvector
VECTOR_COLLECTION=drugcentral_cohere_v4_1024_20260930
STRUCTURED_COLLECTION=drugcentral-sections-20260918
RETRIEVAL_CANDIDATES=20
RERANK_TOP_K=8
DENSE_WEIGHT=1
LEXICAL_WEIGHT=1
GENERATION_MAX_TOKENS=1600
GENERATION_TEMPERATURE=0
GENERATION_TOP_P=1
REQUEST_TIMEOUT=60
MAX_RETRIES=2
EMBED_CACHE_SIZE=512

# Verified US on-demand generation/rerank list rates, 2026-09-30.
# Embedding price verified from Bedrock ListFoundationModelAgreementOffers (USE2).
COST_EMBED_INPUT_PER_MILLION=0.12
COST_GENERATION_INPUT_PER_MILLION=0.15
COST_GENERATION_OUTPUT_PER_MILLION=1.20
COST_VALIDATION_INPUT_PER_MILLION=0.15
COST_VALIDATION_OUTPUT_PER_MILLION=1.20
COST_REPAIR_INPUT_PER_MILLION=0.15
COST_REPAIR_OUTPUT_PER_MILLION=1.20
COST_RERANK_PER_REQUEST=0.002
QUERY_LOG_PATH=

# Persist provenance without raw questions; mount this directory durably in deployment.
EVIDENCE_AUDIT_PATH=logs/evidence-audit.jsonl
AUDIT_REQUIRED=1
