# Copy to environments/ec2/.env on the server and chmod 600. Never commit.
POSTGRES_ADMIN_PASSWORD=change-me
RAG_API_PASSWORD=change-me
RAG_INGEST_PASSWORD=change-me
# Required: the api service refuses to start while this is empty. Generate with: openssl rand -base64 32
API_AUTH_TOKEN=
AWS_REGION=us-east-2
# 127.0.0.1 = reachable only through SSH tunnel/Tailscale. 0.0.0.0 exposes the port to the security group.
API_BIND=127.0.0.1
# Graph (optional): set NEO4J_PASSWORD, load the graph dump, then GRAPH_ENABLED=1.
NEO4J_PASSWORD=
GRAPH_ENABLED=0
# Full source DB (optional, only for rebuilds).
SOURCE_DB_PASSWORD=
# ONLY if you skip the EC2 instance role (see docker-compose.keys.yml). Leave unset when using a role.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
