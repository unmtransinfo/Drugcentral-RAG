# Local mode: Ollama models + local pgvector. No AWS account, credentials or AWS calls are used.
# cp environments/local/ollama.env.example .env   (the API and tools read .env from the repository root)

RAG_PIPELINE=local
# CHAT_BACKEND and EMBED_BACKEND default to ollama for RAG_PIPELINE=local; other values are rejected.

# Ollama server (native install or the optional `ollama` Compose profile)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen3.5:9b           # ~6.6 GB; qwen3.5:4b (~3.4 GB) is lighter, answers are less reliable
OLLAMA_EMBED_MODEL=nomic-embed-text    # ~0.3 GB, 768 dimensions
OLLAMA_TIMEOUT_SECONDS=90
ANSWER_MODEL_TIMEOUT_SECONDS=300

# Local pgvector (environments/local/docker-compose.yml, service db). Local-only credentials.
VECTOR_BACKEND=pgvector
# Ollama vectors live in their own collection; it is stamped with backend=ollama and the model name and is
# never served by, or overwritten from, a Bedrock configuration.
VECTOR_COLLECTION=drugcentral_local_nomic_embed_text
PGHOST=127.0.0.1
PGPORT=55432
PGDATABASE=drugcentral_rag
PGUSER=rag_local
PGPASSWORD=change-me-local-db-password
PGSSLMODE=disable

# API authentication: leave empty to disable on your machine, or set a long random value
# (openssl rand -base64 32) to require "Authorization: Bearer <token>" on /api/chat and /api/metrics.
API_AUTH_TOKEN=
SESSION_BACKEND=memory

# Optional local data (see data/README.md); answers work without them.
# LABEL_DATABASE=data/labels.sqlite
# RELATIONS_DATABASE=data/relations.sqlite

# Ingestion only: the source database (Compose profile `source`) and the dataset version recorded in metadata.
SOURCE_DB_PASSWORD=change-me-local-source-password
SOURCE_DATABASE_URL=postgresql://postgres:change-me-local-source-password@127.0.0.1:55433/drugcentral
DATASET_VERSION=drugcentral-56-2026-09-02
