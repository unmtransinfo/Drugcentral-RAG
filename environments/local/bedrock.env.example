# Bedrock mode on your machine: the verified pipeline with YOUR AWS account and a local pgvector database.
# cp environments/local/bedrock.env.example .env   (the API and tools read .env from the repository root)
#
# AWS credentials come only from the standard AWS credential chain of your shell: an AWS CLI profile or SSO
# session (AWS_PROFILE), environment variables, or an instance role. Never put access keys in this file or commit
# them. Bedrock calls are billed to that account; enable the models below for it first (Bedrock model access).

RAG_PIPELINE=verified-bedrock
# CHAT_BACKEND and EMBED_BACKEND default to bedrock for this mode; other values are rejected.
AWS_REGION=us-east-2
# AWS_PROFILE=your-profile

BEDROCK_EMBED_REGION=us-east-2
BEDROCK_EMBED_MODEL=us.cohere.embed-v4:0
BEDROCK_EMBED_DIMENSIONS=1024
BEDROCK_RERANK_REGION=us-west-2
BEDROCK_RERANK_MODEL=cohere.rerank-v3-5:0
BEDROCK_GENERATION_MODEL=qwen.qwen3-next-80b-a3b
BEDROCK_VALIDATION_MODEL=qwen.qwen3-next-80b-a3b
RETRIEVAL_CANDIDATES=20
RERANK_TOP_K=8
DENSE_WEIGHT=1
LEXICAL_WEIGHT=1
GENERATION_MAX_TOKENS=1600
GENERATION_TEMPERATURE=0
GENERATION_TOP_P=1
REQUEST_TIMEOUT=60
MAX_RETRIES=2
EMBED_CACHE_SIZE=512

# Your own collections, built with docs/FULL_COVERAGE.md (Cohere vectors + structured snapshot). They are stamped
# with the Bedrock embedding identity and are never mixed with the Ollama collection of local mode.
VECTOR_BACKEND=pgvector
VECTOR_COLLECTION=drugcentral_dev_cohere_v4_1024
STRUCTURED_COLLECTION=drugcentral_dev_sections
PGHOST=127.0.0.1
PGPORT=55432
PGDATABASE=drugcentral_rag
PGUSER=rag_local
PGPASSWORD=change-me-local-db-password
PGSSLMODE=disable

# Optional relationship graph (your own Neo4j); leave disabled unless you built it with ingestion.graph_build.
GRAPH_ENABLED=0

# The verified pipeline writes an evidence audit record per answer and refuses to answer if it cannot.
EVIDENCE_AUDIT_PATH=logs/evidence-audit.jsonl
AUDIT_REQUIRED=1

# API authentication: leave empty to disable on your machine, or set a long random value.
API_AUTH_TOKEN=
SESSION_BACKEND=memory

# Ingestion only (docs/FULL_COVERAGE.md)
SOURCE_DB_PASSWORD=change-me-local-source-password
SOURCE_DATABASE_URL=postgresql://postgres:change-me-local-source-password@127.0.0.1:55433/drugcentral
DATASET_VERSION=drugcentral-56-2026-09-02
